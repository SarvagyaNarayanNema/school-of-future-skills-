# ==============================================================================
# SCHOOL OF FUTURE SKILLS — PRODUCTION ENVIRONMENT CONFIGURATION
# Copy this file to .env and configure secret keys and credentials.
# NEVER commit raw passwords or production API tokens to source control.
# ==============================================================================

# Application Environment
ENV=production
DEBUG=false
APP_NAME="School of Future Skills & IT"

# Database Configuration (PostgreSQL for Production, SQLite for Local Dev)
# Local SQLite Dev Default: sqlite:///./futureskills.db
DATABASE_URL=postgresql://fsit_admin:replace_with_secure_password@localhost:5432/futureskills_prod

# JWT & Authentication Security
# Generate a cryptographically secure 256-bit key: openssl rand -hex 32
SECRET_KEY=replace_with_a_cryptographically_secure_random_key_min_32_bytes
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=https://sgsuniversity.ac.in,http://localhost:3000,http://localhost:80

# File Upload Storage Security
UPLOAD_DIR=./backend/uploads
MAX_UPLOAD_SIZE_BYTES=10485760 # 10 MB

# Rate Limiting Configuration
AUTH_RATE_LIMIT_MAX_ATTEMPTS=15
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# FutureBot AI Intelligence
# Optional external LLM fallback (defaults to indexed local RAG knowledge base)
GEMINI_API_KEY=
OPENAI_API_KEY=
